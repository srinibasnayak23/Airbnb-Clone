<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br>
        <h3>Edit your listing </h3>
        <form action="/listings/<%= listing.id %>?_method=PUT" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="form-lebel">Title</label>
                <input type="text" 
                    name="listing[title]" 
                    value="<%= listing.title %>" 
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">Enter title</div>
            </div>
    
            <div class="mb-3">
                <label for="description" class="form-lebel">Description</label>
                <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
            </div>
    
            <div class="mb-3">
                <label for="image" class="form-lebel">Image Link</label>
                <input type="text" name="listing[image]" value="<%= listing.image.url %>" class="form-control" required>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-lebel">Price</label>
                    <input type="number" name="listing[price]" value="<%= listing.price %>" class="form-control" required>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-lebel">Country</label>
                    <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-lebel">Location</label>
                <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control" required>
            </div>
    
            <br>
            <button class="btn btn-dark edit-btn">Edit</button>
            <br><br>
        </form>
    </div>

</div>
<script src="/js/script.js"></script>